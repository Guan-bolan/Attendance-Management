{
  "name": "xinmiao-attendance",
  "version": "0.1.0",
  "private": true,
  "description": "考勤管理系统（Electron + better-sqlite3 + React + TypeScript）",
  "main": "./out/main/index.js",
  "scripts": {
    "postinstall": "install-electron",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "dist": "electron-vite build && electron-builder --win nsis",
    "dist:portable": "electron-vite build && electron-builder --win portable",
    "test": "vitest run",
    "seed:demo": "node scripts/seed-demo.mjs"
  },
  "dependencies": {
    "@ant-design/icons": "5.6.1",
    "antd": "5.29.3",
    "archiver": "5.3.2",
    "better-sqlite3": "13.0.3",
    "chokidar": "4.0.3",
    "exceljs": "4.4.0",
    "exifr": "7.1.3",
    "pinyin-pro": "3.29.5",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "unzipper": "0.10.14"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "electron": "45.2.3",
    "electron-builder": "26.18.1",
    "electron-vite": "6.0.0",
    "typescript": "5.9.3",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  }
}
